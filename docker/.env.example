# Copy to .env and fill in. .env is git-ignored — keep these values out of the repo.

# tronbyt-server base URL and the target device.
TRONBYT_URL=http://YOUR-TRONBYT-SERVER:8100
DEVICE_ID=your-device-id

# Device API key (from the tronbyt web UI). Secret.
API_KEY=replace-with-device-api-key

# Your Claude credential, pasted in as one line (no file to transfer). Get it on
# a Mac where Claude Code is logged in with:
#   security find-generic-password -s "Claude Code-credentials" -w
# then paste the whole {"claudeAiOauth":{...}} blob after the = below.
# (On a Linux box with Claude Code, it's the contents of ~/.claude/.credentials.json.)
# The container seeds itself from this on first boot and then keeps the rotating
# token in a Docker volume. Secret — treat like a password.
CLAUDE_CREDENTIALS_JSON=

# Installation id in the device's app rotation.
INSTALL_ID=claudeusage

# Seconds between pushes.
PUSH_INTERVAL=60
